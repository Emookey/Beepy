# Human-readable application name exposed by health/config responses.
APP_NAME=CHANGE_ME

# PostgreSQL database name used by Compose and health checks.
POSTGRES_DB=CHANGE_ME
# PostgreSQL application user used by Compose and backup tooling.
POSTGRES_USER=CHANGE_ME
# PostgreSQL password. Generate a new value for each deployment.
POSTGRES_PASSWORD=CHANGE_ME
# Direct SQLAlchemy connection URL. Compose constructs this from the PostgreSQL values above.
DATABASE_URL=CHANGE_ME

# Microsoft Entra application/client identifier used for browser sign-in.
ENTRA_CLIENT_ID=CHANGE_ME
# Microsoft Entra tenant/directory identifier used to validate sign-in tokens.
ENTRA_TENANT_ID=CHANGE_ME
# Email domain permitted to sign in and join projects.
ALLOWED_EMAIL_DOMAIN=CHANGE_ME

# AutoTask API identity and integration configuration.
AUTOTASK_USERNAME=CHANGE_ME
# AutoTask API secret. Never commit a real value.
AUTOTASK_SECRET=CHANGE_ME
AUTOTASK_INTEGRATION_CODE=CHANGE_ME
# AutoTask REST API base URL.
AUTOTASK_BASE_URL=CHANGE_ME
# AutoTask browser deep-link base used in ticket citations.
AUTOTASK_WEB_BASE_URL=CHANGE_ME

# Ollama service URL and required local model names.
OLLAMA_URL=CHANGE_ME
OLLAMA_MODEL=CHANGE_ME
OLLAMA_EMBED_MODEL=CHANGE_ME
# Ollama request timeout in seconds and context-window size.
OLLAMA_TIMEOUT_SECONDS=CHANGE_ME
OLLAMA_CONTEXT=CHANGE_ME

# Odysseus compatibility integration. Supply deployment-specific values externally.
ODYSSEUS_BASE_URL=CHANGE_ME
ODYSSEUS_ENDPOINT_ID=CHANGE_ME
ODYSSEUS_OLLAMA_BASE=CHANGE_ME

# AutoTask synchronization cadence and paging controls.
SYNC_INTERVAL_SECONDS=CHANGE_ME
FULL_SYNC_ON_EMPTY=CHANGE_ME
MAX_AUTOTASK_PAGES=CHANGE_ME
SYNC_OVERLAP_MINUTES=CHANGE_ME
INITIAL_FULL_SYNC=CHANGE_ME

# Ticket retrieval ranking and result controls.
SEMANTIC_MIN_SCORE=CHANGE_ME
LEXICAL_WEIGHT=CHANGE_ME
SEMANTIC_WEIGHT=CHANGE_ME
BEEPY_MAX_TICKETS=CHANGE_ME
# Optional threshold read directly by the legacy semantic search helper.
SEMANTIC_TICKET_THRESHOLD=CHANGE_ME

# Application logging verbosity.
LOG_LEVEL=CHANGE_ME
# Filesystem root for uploaded project files when running outside the current Compose defaults.
PROJECT_UPLOAD_ROOT=CHANGE_ME
